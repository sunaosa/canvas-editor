# ===== 环境变量模板（可以提交到 git）=====
# 复制本文件为 .env.local 并填入实际值：
#   cp .env.example .env.local

# PostgreSQL 数据库连接（Prisma 格式）
# 原 JDBC 格式: jdbc:postgresql://HOST:PORT/DBNAME
# 转换为: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=""

# JWT 密钥（生产环境必须替换，可运行 openssl rand -base64 32 生成）
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Bcrypt 加密强度（10-12 推荐）
BCRYPT_SALT_ROUNDS="10"